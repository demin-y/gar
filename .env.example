# GAR Development Environment
# Скопируйте в .env и измените при необходимости: cp .env.example .env

# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Порты БД на хосте
POSTGRES_DEV_PORT=6432
POSTGRES_TEST_PORT=6433

# База ГАР для примеров и консоли (гем не читает DATABASE_URL приложения)
GAR_DATABASE_URL=postgresql://postgres:postgres@localhost:6432/gar_db_dev
